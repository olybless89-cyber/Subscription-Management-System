// Web Oracle Host - Prisma schema
// Targets PostgreSQL (Railway's DATABASE_URL). This sandbox can't run
// `prisma generate`/`prisma validate` against it (no network access to
// binaries.prisma.sh) — verified instead by Railway's own build, since
// its environment has open network access this sandbox doesn't.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TERMINATED
}

// What kind of website/product this customer runs — captured at
// onboarding specifically so the super admin knows what they're
// configuring Railway infrastructure for later (a banking site and a
// delivery app have very different hosting-mode/suspension-strategy
// needs). OTHER covers anything that doesn't fit the presets.
enum WebsiteType {
  ONLINE_BANKING
  INVESTMENT
  ECOMMERCE
  DELIVERY
  SAAS
  WEB_APP
  CORPORATE
  OTHER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  TERMINATED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  FOUR_MONTHS
  SEMI_ANNUAL
  YEARLY
  CUSTOM
}

enum HostingMode {
  DEDICATED
  SHARED_SERVICE
  MULTI_TENANT
}

enum SuspensionStrategy {
  STOP_DEPLOYMENT
  APP_LEVEL
  REDIRECT
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum RailwayResourceStatus {
  ACTIVE
  STOPPED
  UNKNOWN
  ERROR
}

enum SuspensionAction {
  WARNING
  GRACE_STARTED
  SERVICE_STOPPED
  APP_SUSPENDED
  RESTORED
  MANUAL_SUSPENSION
  MANUAL_RESTORATION
}

enum SuspensionResult {
  SUCCESS
  FAILED
  SKIPPED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// RECEIPT = auto-generated when a payment is verified/recorded, proof
// of what was paid. DUE = auto-generated when a subscription moves to
// PAYMENT_DUE, showing what's owed and by when.
enum InvoiceType {
  RECEIPT
  DUE
}

enum InvoiceStatus {
  PENDING
  PAID
}

enum PaymentProviderName {
  PAYSTACK
  FLUTTERWAVE // routing/schema support exists; provider adapter not yet implemented — see src/lib/payments/registry.ts
}

// ---------- MODELS ----------

model Customer {
  id                  String              @id @default(cuid())
  customerCode        String              @unique // WOH-000001
  name                String
  email               String              @unique // login/account email
  notificationEmail   String?             // where notifications actually go, if different from the login email — falls back to `email` when null
  passwordHash        String?             // customer portal login; null until they set one (e.g. invite flow)
  phone               String?
  dateOfBirth         DateTime?           // used by the daily birthday-message cron — only month/day matter, year is stored but not checked
  serviceStartDate     DateTime?           // manual contract/service dates — independent of subscription billing periods
  serviceEndDate       DateTime?
  websiteType          WebsiteType?        // what kind of site/product this is — informs Railway hosting-mode/suspension-strategy choices
  status              CustomerStatus      @default(ACTIVE)
  automaticSuspension Boolean             @default(true)
  automaticSuspensionOffReason String?
  paymentProvider     PaymentProviderName @default(PAYSTACK) // which provider this customer's checkouts/webhooks route through
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  subscriptions       Subscription[]
  domains             Domain[]
  notifications       Notification[]
  adminAssignments    AdminCustomerAssignment[]
  adminNotifications  AdminNotification[]
  invoices            Invoice[]

  @@index([status])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  amount        Int // stored in minor units (kobo)
  currency      String         @default("NGN")
  billingCycle  BillingCycle
  gracePeriodDays Int          @default(2)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                  String              @id @default(cuid())
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId              String
  plan                Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)

  status              SubscriptionStatus  @default(TRIAL)
  startDate           DateTime            @default(now())
  currentPeriodStart  DateTime            @default(now())
  currentPeriodEnd    DateTime
  nextBillingDate     DateTime
  gracePeriodEnd      DateTime?
  autoRenew           Boolean             @default(true)
  suspensionEnabled   Boolean             @default(true)
  suspendedAt         DateTime?
  // Per-subscription override of SUSPENSION_DRY_RUN — null means
  // "inherit the global env var". Lets an admin test real
  // suspend/restore against one throwaway subscription (override:
  // false) without disarming dry-run protection for every other
  // customer, or force-protect one specific subscription (override:
  // true) even if the global var is off. See
  // src/lib/suspension/dry-run-override.ts.
  dryRunOverride      Boolean?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  payments            Payment[]
  railwayResources     RailwayResource[]
  suspensionEvents     SuspensionEvent[]
  invoices             Invoice[]

  @@index([status])
  @@index([nextBillingDate])
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  reference       String        @unique // provider transaction reference, enforces webhook idempotency
  provider        String        @default("paystack")
  amount          Int
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  rawPayload      String? // JSON blob of provider payload for audit
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model Domain {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  domainName    String    @unique
  isPrimary     Boolean   @default(true)
  railwayStatus String? // synced status string from Railway domain query
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RailwayResource {
  id                 String                 @id @default(cuid())
  subscriptionId     String
  subscription       Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  projectId          String
  environmentId      String
  serviceId          String
  deploymentId       String?

  hostingMode        HostingMode
  suspensionStrategy SuspensionStrategy

  status             RailwayResourceStatus  @default(UNKNOWN)
  lastSyncedAt       DateTime?
  lastError          String?

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([hostingMode])
  @@index([status])
}

model SuspensionEvent {
  id             String            @id @default(cuid())
  subscriptionId String
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  action         SuspensionAction
  reason         String
  strategy       SuspensionStrategy
  result         SuspensionResult
  errorMessage   String?
  performedBy    String? // AdminUser id, or null for automated worker
  dryRun         Boolean           @default(false)

  createdAt      DateTime          @default(now())

  @@index([subscriptionId])
  @@index([result])
}

model Notification {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  channel    String // EMAIL | WHATSAPP | SMS | IN_APP
  event      String // PAYMENT_DUE | GRACE_PERIOD | SUSPENDED | ...
  message    String
  sentAt     DateTime?
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  passwordChangedAt DateTime? // null = never changed since account creation; set on self-change AND super-admin reset
  role         AdminRole @default(ADMIN)
  canManageAdmins Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignments       AdminCustomerAssignment[]
  adminNotifications AdminNotification[]
}

// spec extension: scoped admin visibility. A row here means the given
// admin can see/monitor the given customer. SUPER_ADMIN role bypasses
// this table entirely (sees everyone) — see canAdminAccessCustomer() in
// src/lib/auth/authorize.ts. Plain ADMIN role sees ONLY customers with a
// row here.
model AdminCustomerAssignment {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([adminId, customerId])
  @@index([customerId])
}

// Per-admin copy of customer-facing notifications, routed by assignment
// (spec extension). SUPER_ADMINs get a row for every customer
// notification regardless of assignment; plain ADMINs only get rows for
// customers assigned to them. See notifyAdminsForCustomer() in
// src/lib/notifications/admin-notify.ts.
model AdminNotification {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event      String
  message    String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([customerId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Singleton row backing sequential, never-reused customer codes
// (spec section 5: WOH-000001, WOH-000002, ...). A dedicated counter
// table rather than COUNT(*) on Customer, so the sequence survives even
// if a customer is ever permanently deleted (spec section 44).
model CustomerCodeCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

// Same pattern as CustomerCodeCounter — sequential, never-reused
// invoice numbers (INV-000001, ...) that survive even if an invoice
// row is ever deleted.
model InvoiceCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique // INV-000001
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  type           InvoiceType
  status         InvoiceStatus @default(PENDING)
  amount         Int // minor units (kobo/cents)
  currency       String
  description    String // e.g. plan name + billing period, shown as the line item
  dueDate        DateTime?
  paidAt         DateTime?
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([customerId])
  @@index([subscriptionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // AdminUser id or "SYSTEM"
  action    String
  target    String?
  ip        String?
  metadata  String? // JSON
  result    String // SUCCESS | FAILED
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
